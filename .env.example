# Copy to .env, then replace only ONE generator provider's placeholder key.
# Do not commit .env.

# Primary generator: Google Gemini (recommended)
# Create a free-tier key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional direct providers already supported by the dashboard
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=

# Optional OpenAI-compatible VLM endpoint.
# The dashboard calls this provider "llama". Choose ONE endpoint below.
#
# Together AI example:
# LLAMA_BASE_URL=https://api.together.xyz/v1
# LLAMA_API_KEY=your_together_api_key_here
# LLAMA_MODEL=your_actual_together_vision_model_id
#
# OpenRouter example:
# LLAMA_BASE_URL=https://openrouter.ai/api/v1
# LLAMA_API_KEY=your_openrouter_api_key_here
# LLAMA_MODEL=provider/vision-model-id
#
# DashScope / Qwen-VL example:
# LLAMA_BASE_URL=https://YOUR_WORKSPACE_ID.REGION.maas.aliyuncs.com/compatible-mode/v1
# LLAMA_API_KEY=your_dashscope_api_key_here
# LLAMA_MODEL=your_enabled_qwen_vl_model_id
LLAMA_BASE_URL=
LLAMA_API_KEY=
LLAMA_MODEL=

# Hugging Face: write token (Prithvi) or read token (teammates) for the results dataset repo.
HF_TOKEN=
RESULTS_REPO=vlm-reliability-pccoe/vlm-results
# Optional HF Inference Providers vision model for the hf-router provider.
HF_ROUTER_MODEL=
